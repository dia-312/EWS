# Copy to .env.local and fill in. Never commit .env.local.

# Which store this deployment serves (matches stores.slug)
STORE_SLUG=

# Supabase project (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to client code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (used for share links, QR codes, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
